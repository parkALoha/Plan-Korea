#!/usr/bin/env sh
# pre-commit — จับ commit ที่แตะการต่อ Supabase/env ตั้งแต่บนเครื่อง ก่อนถึง CI
#
# ติดตั้ง (P1 รันครั้งเดียว ครอบทั้ง 2 worktree เพราะแชร์ .git/config):
#     git config core.hooksPath .github/hooks
#
# 🔴 hook นี้ "ไม่ใช่ด่านของทีม" — CI คือด่านจริง · hook เป็นแค่ตัวจับก่อนให้รู้เร็ว
#    ห้ามนับเป็นสองด่าน · เหตุผล:
#      - ใครก็ตามที่ clone ใหม่ต้องตั้ง core.hooksPath เอง ไม่มีอะไรบังคับ
#      - `git commit --no-verify` ข้ามได้เสมอ
#
# ══════════════════════════════════════════════════════════════════════════════
# 🔴 ห้ามลบการเช็ค branch ข้างล่าง แม้จะดูเหมือนโค้ดตายในวันนี้
#
# วันนี้มันดูไม่จำเป็น เพราะ core.hooksPath = ".github/hooks" เป็น **พาธสัมพัทธ์**
# ซึ่ง git resolve เทียบรากของ worktree แต่ละอัน:
#     /Users/park/plan-korea-platform/.github/hooks  ← มีจริง → hook ทำงาน
#     /Users/park/plan-korea/.github/hooks           ← ไม่มี  → ไม่มี hook ทำงานบน main
# (`.git/config` ถูกแชร์ระหว่าง worktree จริง **แต่พาธที่มันชี้ไปคนละที่** — จุดนี้เข้าใจผิดกันมาแล้ว)
#
# 🔴 แต่ไฟล์นี้ถูก commit อยู่บน branch `platform` → **วันที่ `platform` merge เข้า `main`
#    (หลังทริป) ไฟล์จะไปโผล่ในทรีหลักทันที และ hook จะเริ่มทำงานบน `main` เอง**
#    ตอนนั้น **การเช็ค branch บรรทัดล่างคือสิ่งเดียวที่กันไม่ให้ hook ขวางการแก้บั๊กบน main**
#    ใครที่มาอ่านวันนี้แล้วคิดว่า "ไม่มีทางรันบน main อยู่แล้ว" จะลบมันทิ้งได้ง่ายมาก
#
# เหตุผลที่ต้องกัน: `main` คือเว็บทริปที่ **ต้องแก้บั๊กได้ทันทีตลอดเวลาระหว่างอยู่เกาหลี**
# ด่านที่ขวางการแก้บั๊กหน้างาน แย่กว่าความเสี่ยงที่มันกัน — หลักเดียวกับ fail-open ใน proxy.ts:43
#
# ⚠️ อีกทางที่ทำให้ hook ไปโผล่บน main: มีคนเปลี่ยน core.hooksPath เป็น **พาธสัมบูรณ์**
#    ซึ่ง resolve เหมือนกันทุก worktree · การเช็ค branch กันเคสนี้ด้วย
# ══════════════════════════════════════════════════════════════════════════════
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
[ "$branch" = "platform" ] || exit 0

root="$(git rev-parse --show-toplevel)"
[ -x "$root/.github/diff-guard.sh" ] || exit 0

git diff --cached --name-only | "$root/.github/diff-guard.sh" --stdin "$root" || {
  echo ""
  echo "🔴 commit ถูกหยุดโดย .github/hooks/pre-commit"
  echo "   กติกา: ห้าม commit ที่แตะการต่อ Supabase/env ลง platform จนกว่าเรื่อง Vercel จะปิด"
  echo "   ถ้าจำเป็นจริงและรู้ว่ากำลังทำอะไร: git commit --no-verify"
  echo "   (แต่ CI จะจับซ้ำอยู่ดี — คุยกับ P1 ก่อนดีกว่า)"
  exit 1
}
